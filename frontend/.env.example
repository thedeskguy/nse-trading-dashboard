# Copy to .env.local — never commit .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local dev: http://localhost:8000
# Vercel production: set to your Railway URL, e.g. https://nse-trading-dashboard.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Razorpay — use rzp_test_... for dev, rzp_live_... for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Set to "true" to enable the Pro paywall (ends free beta). Build-time flag.
NEXT_PUBLIC_PAYWALL_ENABLED=false
